{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "business-funding-skills/dossier/v1",
  "title": "Business Funding Skills - dossier scambiabile",
  "type": "object",
  "required": ["schema", "dossier_id", "created", "updated", "instrument_types", "opportunity", "sources", "requirements"],
  "properties": {
    "schema": {"const": "business-funding-skills/dossier@v1"},
    "dossier_id": {"type": "string", "minLength": 1},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "instrument_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GRANT", "LOAN", "GUARANTEE", "EQUITY", "INCUBATION", "INTERNATIONALIZATION"]}},
    "opportunity": {
      "type": "object",
      "required": ["id", "title", "last_checked"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
        "last_checked": {"type": "string", "format": "date"},
        "authority": {"type": "string"}, "jurisdiction": {"type": "string"},
        "eu_programme": {"type": "string"}, "eu_management_mode": {"enum": ["diretta", "concorrente", "indiretta", "NON_VERIFICATO"]},
        "qfp_cycle": {"type": "string"}
      }
    },
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "title", "url", "checked_at", "state"],
      "properties": {"id": {"type": "string", "pattern": "^SRC-"}, "title": {"type": "string"}, "url": {"type": "string"}, "checked_at": {"type": "string", "format": "date"}, "state": {"$ref": "#/$defs/state"}, "version": {"type": ["string", "null"]}, "section": {"type": ["string", "null"]}}}},
    "requirements": {"type": "array", "items": {"type": "object", "required": ["id", "text", "state", "source_id"],
      "properties": {"id": {"type": "string", "pattern": "^REQ-"}, "text": {"type": "string"}, "state": {"$ref": "#/$defs/state"}, "source_id": {"type": "string"}, "verified_at": {"type": "string", "format": "date"}, "section": {"type": "string"}, "note": {"type": "string"}}}},
    "project": {"type": "object"}, "financials": {"type": "object"}
  },
  "$defs": {"state": {"enum": ["VERIFICATO", "DA_CONFERMARE", "IPOTESI", "PROPOSTA", "DECISIONE_APPROVATA", "MANCANTE", "NON_APPLICABILE"]}}
}